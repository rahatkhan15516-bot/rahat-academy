    function filterCatalog() {
      const query = document.getElementById("searchInput").value.toLowerCase();
      const container = document.getElementById("catalogContainer");

      const filtered = CATALOG_DATA.filter(p => currentSubject === "সব বিষয়" || p.subject === currentSubject)
        .map(p => {
          const matched = p.topics.filter(t => t.title.toLowerCase().includes(query) || (t.sub && t.sub.toLowerCase().includes(query)));
          return { ...p, topics: matched };
        }).filter(p => p.topics.length > 0);

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="text-center py-12 bg-white rounded-2xl border border-slate-200 shadow-sm">
            <p class="text-slate-500 text-sm font-semibold">দুঃখিত, কোনো টপিক খুঁজে পাওয়া যায়নি!</p>
          </div>
        `;
        return;
      }

      container.innerHTML = filtered.map(paper => `
        <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
          <div class="bg-slate-100/80 px-4 py-3 border-b border-slate-200 flex items-center justify-between">
            <span class="text-sm font-bold text-slate-900 flex items-center">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500 mr-2"></span>
