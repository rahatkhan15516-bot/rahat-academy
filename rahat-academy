      selectedOnlineMethod = m;
      document.getElementById("onlineMethodDisplayLabel").innerText = `${m.toUpperCase()} পার্সোনাল নম্বর:`;
      const buttons = document.querySelectorAll("#onlineMethodButtons .on-pay-btn");
      buttons.forEach(btn => {
        if (btn.innerText.includes(m === 'bKash' ? 'বিকাশ' : m === 'Nagad' ? 'নগদ' : m === 'Rocket' ? 'রকেট' : 'উপায়')) {
