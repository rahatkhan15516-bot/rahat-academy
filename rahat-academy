                  ${t.sub ? `<p class="text-[11px] text-slate-500 mt-0.5">${t.sub}</p>` : ''}
                </div>

                <div class="flex items-center space-x-2 mt-3.5 pt-2 border-t border-slate-100">
                  <button onclick="openReader('${t.title}', '${paper.paper}', false)" class="flex-1 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-lg transition text-center">
