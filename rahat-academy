<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>রাহাত একাডেমি — HSC 2027 এডুকেশনাল ডিজিটাল মার্কেটপ্লেস</title>
  
  <!-- SEO & Open Graph Meta Tags -->
  <meta name="description" content="মো: রাহাত খান পরিচালিত রাহাত একাডেমি। এইচএসসি ২০২৭ বিজ্ঞানের সকল বিষয়ের অধ্যায়ভিত্তিক প্রিমিয়াম রিভিশন ও লেকচার শিট।">
  <meta property="og:title" content="রাহাত একাডেমি — স্মার্ট প্রস্তুতি, গুছানো নোট, আত্মবিশ্বাসী পরীক্ষা">
  <meta property="og:description" content="বাংলা, ইংরেজি, আইসিটি ও বিজ্ঞানের প্রতিটি বিষয়ের টপিকভিত্তিক স্পেশাল রিভিশন পিডিএফ।">
  <meta property="og:type" content="website">

  <!-- Tailwind CSS & Professional Bengali Font -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style>
    body { font-family: 'Hind Siliguri', -apple-system, sans-serif; background-color: #f8fafc; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    /* থার্ড পার্টি বা পেস্টবিন বিজ্ঞাপন চিরতরে বন্ধ রাখার সুরক্ষা */
    a[href*="paste.page"], div[class*="paste-page"], .paste-page-badge, footer:last-of-type, body > div:last-child {
      display: none !important; visibility: hidden !important; opacity: 0 !important; pointer-events: none !important;
      height: 0 !important; width: 0 !important; overflow: hidden !important;
    }
  </style>
</head>
<body class="text-slate-800 antialiased pb-24 selection:bg-blue-900 selection:text-amber-400">

  <!-- ========================================== -->
  <!-- 1. TOP NAVIGATION BAR                      -->
  <!-- ========================================== -->
  <header class="sticky top-0 z-40 bg-slate-900 text-white border-b border-slate-800 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center space-x-3 cursor-pointer" onclick="switchMainView('home')">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 to-amber-300 flex items-center justify-center text-slate-950 font-black text-xl shadow-md border border-amber-200">
          R
        </div>
        <div>
          <h1 id="brandNameNav" class="text-lg font-bold tracking-tight text-white leading-tight">রাহাত একাডেমি</h1>
          <p id="ownerNameNav" class="text-[11px] text-amber-400 font-semibold">পরিচালক: মো: রাহাত খান</p>
        </div>
      </div>

      <div class="flex items-center space-x-2">
        <button onclick="switchMainView('studentDashboard')" class="text-xs font-semibold px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition">
          আমার লাইব্রেরি
        </button>
        <button onclick="openAdminModal()" class="text-xs font-bold px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 shadow transition flex items-center">
          <span class="w-2 h-2 rounded-full bg-slate-950 mr-1.5 animate-pulse"></span>
          অ্যাডমিন প্যানেল
        </button>
      </div>
    </div>
  </header>

  <!-- ========================================== -->
  <!-- 2. HOME VIEW (MAIN STOREFRONT)             -->
  <!-- ========================================== -->
  <div id="homeView">
    <!-- Hero Section -->
    <section class="bg-gradient-to-b from-slate-900 via-blue-950 to-slate-900 text-white pt-12 pb-16 px-4 text-center relative overflow-hidden">
      <div class="max-w-4xl mx-auto space-y-4 relative z-10">
        <div class="inline-flex items-center space-x-2 bg-amber-500/10 border border-amber-400/30 text-amber-300 text-xs px-3.5 py-1.5 rounded-full font-bold">
          <span>🎯 এইচএসসি ২০২৭ স্পেশাল ডিজিটাল ক্যাটালগ</span>
        </div>
        <h2 id="heroHeadingText" class="text-2xl md:text-5xl font-extrabold leading-snug tracking-tight text-white">
          স্মার্ট প্রস্তুতি, গুছানো নোট,<br class="hidden sm:inline"> আত্মবিশ্বাসী পরীক্ষা।
        </h2>
        <p id="heroSubheadingText" class="text-slate-300 text-xs md:text-base max-w-2xl mx-auto leading-relaxed">
          বাংলা, ইংরেজি, আইসিটি ও বিজ্ঞানের প্রতিটি বিষয়ের টপিকভিত্তিক প্রিমিয়াম রিভিশন শিট। অনলাইনে সুরক্ষিতভাবে পড়ুন অথবা সরাসরি ক্যাশে সংগ্রহ করুন।
        </p>

        <!-- Search Bar -->
        <div class="max-w-lg mx-auto pt-4">
          <div class="relative">
            <input
              type="text"
              id="searchInput"
              onkeyup="filterCatalog()"
              placeholder="অধ্যায় বা বিষয়ের নাম দিয়ে খুঁজুন (যেমন: ভেক্টর, অপরিচিতা, গতিবিদ্যা)..."
              class="w-full pl-4 pr-10 py-3.5 rounded-2xl text-slate-900 text-sm shadow-2xl focus:outline-none focus:ring-2 focus:ring-amber-400 placeholder:text-slate-400 bg-white"
            />
            <span class="absolute right-3.5 top-3.5 text-slate-400">🔍</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Subject Filter Tabs -->
    <section class="sticky top-14 z-30 bg-white border-b border-slate-200 py-2.5 px-4 shadow-sm">
      <div id="subjectTabs" class="max-w-7xl mx-auto flex items-center space-x-2 overflow-x-auto no-scrollbar"></div>
    </section>

    <!-- 151 Topics Catalog -->
    <main class="max-w-7xl mx-auto px-4 py-8 space-y-6">
      <div class="flex items-center justify-between border-b border-slate-200 pb-3">
        <div>
          <h3 class="text-lg font-bold text-slate-900">পাঠ্যসূচি ও রিভিশন শিট তালিকা</h3>
          <p class="text-xs text-slate-500">এইচএসসি ২০২৭ — মোট ১৩টি পত্রের অধ্যায়ভিত্তিক ১৫১টি টপিক</p>
        </div>
        <div class="flex items-center space-x-2">
          <span class="text-xs bg-amber-50 text-amber-800 border border-amber-300 px-3 py-1 rounded-full font-bold">
            ডিফল্ট মূল্য: ৳<span id="defaultPriceBadge">30</span>
          </span>
        </div>
      </div>

      <div id="catalogContainer" class="space-y-6"></div>
    </main>
  </div>

  <!-- ========================================== -->
  <!-- 3. STUDENT DASHBOARD VIEW                  -->
  <!-- ========================================== -->
  <div id="studentDashboardView" class="hidden max-w-5xl mx-auto px-4 py-8 space-y-6">
    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <span class="text-xs font-bold text-amber-600 uppercase tracking-wider">শিক্ষার্থী পোর্টাল</span>
        <h2 class="text-xl font-bold text-slate-900">আমার লাইব্রেরি ও অর্ডার ট্র্যাকিং</h2>
        <p class="text-xs text-slate-500">আপনার অনুমোদিত পিডিএফ সমূহ এখানে সংরক্ষিত থাকে।</p>
      </div>
      <button onclick="switchMainView('home')" class="text-xs font-bold px-4 py-2 bg-slate-900 text-white rounded-xl hover:bg-slate-800 transition">
        ← বইয়ের ক্যাটালগে ফিরুন
      </button>
    </div>

    <!-- Student Entitlements (Unlocked PDFs) -->
    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-4">
      <h3 class="text-base font-bold text-slate-900 flex items-center">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 mr-2"></span>
        পড়ার জন্য উন্মুক্ত পিডিএফ সমূহ (My Library)
      </h3>
      <div id="studentLibraryList" class="grid grid-cols-1 md:grid-cols-2 gap-3"></div>
    </div>

    <!-- Student Orders History -->
    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm space-y-4">
      <h3 class="text-base font-bold text-slate-900 flex items-center">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-500 mr-2"></span>
        আমার অর্ডারের বর্তমান অবস্থা (Order History)
      </h3>
      <div id="studentOrdersList" class="space-y-2.5"></div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 4. SECURE PDF READER MODAL (ONLINE ONLY)   -->
  <!-- ========================================== -->
  <div id="readerModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/85 p-2 sm:p-4">
    <div class="bg-white w-full max-w-4xl rounded-2xl overflow-hidden shadow-2xl flex flex-col h-[90vh]">
      <!-- Reader Header -->
      <div class="bg-slate-950 text-white px-4 py-3 flex items-center justify-between shrink-0 border-b border-slate-800">
        <div>
          <span id="readerBadge" class="text-[10px] text-amber-400 font-bold uppercase tracking-wider">সুরক্ষিত অনলাইন রিডার</span>
          <h4 id="readerTopicTitle" class="text-xs sm:text-sm font-bold truncate max-w-xs sm:max-w-md">অধ্যায় রিডার</h4>
        </div>
        <button onclick="closeModal('readerModal')" class="text-slate-400 hover:text-white font-bold text-lg p-1">✕</button>
      </div>

      <!-- Watermarked Reader Canvas Container -->
      <div class="relative flex-1 bg-slate-900 flex flex-col items-center justify-center select-none overflow-hidden p-2">
        <!-- Floating Security Dynamic Watermark -->
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-20 transform -rotate-12 z-20">
          <span class="text-red-500 font-black text-2xl text-center leading-relaxed">
            রাহাত একাডেমি • মো: রাহাত খান<br>কপি বা স্ক্রিনশট সম্পূর্ণ নিষিদ্ধ
          </span>
        </div>

        <div id="readerViewerContainer" class="w-full h-full flex flex-col items-center justify-center z-10 overflow-y-auto"></div>
      </div>

      <!-- Reader Footer -->
      <div class="p-3 bg-white border-t border-slate-200 flex items-center justify-between shrink-0">
        <span class="text-[11px] text-slate-500">রাহাত একাডেমি ডিজিটাল রিডার • অনলাইন-অনলি রিডিং</span>
        <button id="readerCheckoutButton" onclick="switchFromPreviewToCheckout()" class="py-2 px-4 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow transition">
          সম্পূর্ণ শিট আনলক করুন
        </button>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 5. CHECKOUT MODAL (ONLINE & CASH PAYMENTS) -->
  <!-- ========================================== -->
  <div id="checkoutModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/80 p-3">
    <div class="bg-white w-full max-w-lg rounded-2xl overflow-hidden shadow-2xl flex flex-col max-h-[90vh]">
      <div class="bg-slate-900 text-white px-5 py-3.5 flex items-center justify-between border-b border-slate-800">
        <div>
          <span class="text-[10px] text-amber-400 font-bold uppercase tracking-wider">অর্ডার ও পেমেন্ট কনফার্মেশন</span>
          <h4 id="checkoutTitle" class="text-xs sm:text-sm font-bold truncate max-w-xs sm:max-w-md">টপিক নাম</h4>
        </div>
        <button onclick="closeModal('checkoutModal')" class="text-slate-400 hover:text-white font-bold text-lg">✕</button>
      </div>

      <div id="checkoutBody" class="p-5 space-y-4 overflow-y-auto">
        <!-- Price Summary -->
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 flex items-center justify-between text-xs">
          <span class="text-slate-600 font-semibold">মোট প্রদেয় মূল্য:</span>
          <span class="font-extrabold text-blue-700 text-base" id="checkoutAmountText">৳৩০</span>
        </div>

        <!-- Payment Type Selector (Online vs Physical Cash) -->
        <div>
          <label class="block text-[11px] font-bold text-slate-700 mb-1.5">পেমেন্ট মেথড নির্বাচন করুন:</label>
          <div class="grid grid-cols-2 gap-2 mb-2">
            <button type="button" id="typeOnlineBtn" onclick="setCheckoutType('online')" class="py-2.5 px-3 rounded-xl text-xs font-bold border-2 border-blue-600 bg-blue-50 text-blue-700 transition text-center shadow-sm">
              📱 অনলাইন পেমেন্ট (বিকাশ/নগদ)
            </button>
            <button type="button" id="typeCashBtn" onclick="setCheckoutType('cash')" class="py-2.5 px-3 rounded-xl text-xs font-bold border-2 border-slate-200 bg-white text-slate-600 hover:bg-slate-50 transition text-center">
              💵 সরাসরি ক্যাশ পেমেন্ট
            </button>
          </div>
        </div>

        <!-- A. ONLINE PAYMENT FORM -->
        <div id="onlinePaymentSection" class="space-y-3.5">
          <div class="grid grid-cols-4 gap-1.5" id="onlineMethodButtons">
            <button type="button" onclick="selectOnlineMethod('bKash')" class="on-pay-btn py-2 text-xs font-bold rounded-lg border border-pink-500 bg-pink-50 text-pink-700">বিকাশ</button>
            <button type="button" onclick="selectOnlineMethod('Nagad')" class="on-pay-btn py-2 text-xs font-bold rounded-lg border border-slate-200 bg-white text-slate-600">নগদ</button>
            <button type="button" onclick="selectOnlineMethod('Rocket')" class="on-pay-btn py-2 text-xs font-bold rounded-lg border border-slate-200 bg-white text-slate-600">রকেট</button>
            <button type="button" onclick="selectOnlineMethod('Upay')" class="on-pay-btn py-2 text-xs font-bold rounded-lg border border-slate-200 bg-white text-slate-600">উপায়</button>
          </div>

          <div class="bg-blue-50/70 p-3.5 rounded-xl border border-blue-200 space-y-1.5 text-xs">
            <div class="flex items-center justify-between">
              <span id="onlineMethodDisplayLabel" class="font-bold text-slate-700 uppercase">BKASH পার্সোনাল নম্বর:</span>
              <span class="bg-blue-600 text-white text-[10px] px-2 py-0.5 rounded-full font-bold">সেন্ড মানি</span>
            </div>
            <div class="bg-white px-3 py-2 rounded-lg border border-blue-300 font-mono font-black text-sm text-blue-950 flex items-center justify-between">
              <span id="checkoutReceiverNumber">01610146429</span>
              <button onclick="copyPaymentNumber()" class="text-[10px] text-blue-600 font-bold bg-blue-50 px-2 py-0.5 rounded border border-blue-200">কপি করুন</button>
            </div>
            <p class="text-[11px] text-slate-600 leading-tight">
              * আপনার অ্যাপ থেকে সেন্ড মানি করে নিচে আপনার প্রেরক নম্বর ও ফিরতি TrxID লিখুন।
            </p>
          </div>

          <div>
            <label class="block text-[11px] font-bold text-slate-700 mb-1">আপনার নাম (Student Name):</label>
            <input type="text" id="onlineStudentNameInput" placeholder="আপনার পূর্ণ নাম লিখুন" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" required>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-700 mb-1">প্রেরক নম্বর (যে নম্বর থেকে টাকা পাঠিয়েছেন):</label>
            <input type="tel" id="onlineSenderPhoneInput" placeholder="01XXXXXXXXX" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" required>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-700 mb-1">ট্রানজ্যাকশন আইডি (Transaction ID / TrxID):</label>
            <input type="text" id="onlineTrxIdInput" placeholder="যেমন: BL98XQ..." class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs font-mono uppercase tracking-wider focus:ring-2 focus:ring-blue-500 focus:outline-none" required>
          </div>
          <button onclick="submitOnlinePaymentOrder()" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-md transition">
            অনলাইন পেমেন্ট সাবমিট করুন
          </button>
        </div>

        <!-- B. PHYSICAL CASH PAYMENT FORM -->
        <div id="cashPaymentSection" class="hidden space-y-3.5">
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-3 text-xs space-y-1">
            <span class="font-bold text-amber-900 block">💵 সরাসরি ক্যাশ পেমেন্ট নিয়মাবলী:</span>
            <p class="text-amber-800 text-[11px] leading-relaxed">
              আপনি স্বত্বাধিকারী <strong>মো: রাহাত খান</strong>-এর নিকট সশরীরে ক্যাশ টাকা প্রদান করবেন। ফর্মটি পূরণ করার পর অ্যাডমিন ক্যাশ পাওয়ার সত্যতা যাচাই করে পিডিএফ সক্রিয় করবেন।
            </p>
          </div>

          <div>
            <label class="block text-[11px] font-bold text-slate-700 mb-1">শিক্ষার্থীর পূর্ণ নাম:</label>
            <input type="text" id="cashStudentNameInput" placeholder="আপনার নাম লিখুন" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none" required>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-700 mb-1">মোবাইল নম্বর:</label>
            <input type="tel" id="cashStudentPhoneInput" placeholder="01XXXXXXXXX" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none" required>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-700 mb-1">ক্যাশ গ্রহণকারীর নাম:</label>
            <input type="text" id="cashReceiverNameInput" value="মো: রাহাত খান" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs bg-slate-100 font-semibold text-slate-700" readonly>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-700 mb-1">টাকা দেওয়ার সম্ভাব্য তারিখ:</label>
            <input type="date" id="cashHandoverDateInput" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none">
          </div>
          <div>
            <label class="block text-[11px] font-bold text-slate-700 mb-1">অতিরিক্ত নোট (ঐচ্ছিক):</label>
            <input type="text" id="cashNoteInput" placeholder="যেমন: ক্লাসে সরাসরি দিয়েছি" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs focus:ring-2 focus:ring-amber-500 focus:outline-none">
          </div>
          <button onclick="submitCashPaymentOrder()" class="w-full py-3 bg-amber-500 hover:bg-amber-600 text-slate-950 text-xs font-bold rounded-xl shadow-md transition">
