    function submitOnlinePaymentOrder() {
      const name = document.getElementById("onlineStudentNameInput").value.trim();
      const phone = document.getElementById("onlineSenderPhoneInput").value.trim();
      const trx = document.getElementById("onlineTrxIdInput").value.trim().toUpperCase();

      if (!name || !phone || !trx) {
        alert("দয়া করে আপনার নাম, প্রেরক নম্বর ও TrxID লিখুন!");
        return;
      }

      // Check duplicate TrxID
      if (orders.some(o => o.trx === trx)) {
        alert("এই TrxID দিয়ে ইতিমধ্যে একটি অর্ডার জমা দেওয়া আছে! অনুগ্রহ করে সঠিক TrxID লিখুন।");
        return;
      }

      const newOrder = {
        id: `ORD-${Date.now().toString().slice(-6)}`,
        type: "online",
        name, phone, trx,
        topic: `${selectedPaper} — ${selectedTopic}`,
        fileKey: `${selectedPaper} — ${selectedTopic}`.replace(" — ", "_"),
        method: selectedOnlineMethod.toUpperCase(),
        amount: config.defaultPrice,
        status: "pending_verification",
        date: new Date().toLocaleDateString('bn-BD')
      };

      orders.unshift(newOrder);
      saveOrders();

      document.getElementById("checkoutBody").classList.add("hidden");
      document.getElementById("checkoutSuccessScreen").classList.remove("hidden");
      document.getElementById("successOrderHeadline").innerText = "অনলাইন পেমেন্ট সাবমিট হয়েছে!";
      document.getElementById("successOrderMessage").innerText = `অর্ডার আইডি: ${newOrder.id}। পরিচালক মো: রাহাত খান এসএমএস মিলিয়ে অনুমোদন দেওয়ার সাথে সাথে আপনার লাইব্রেরিতে পিডিএফ পড়ার সুবিধা চালু হয়ে যাবে।`;
    }

