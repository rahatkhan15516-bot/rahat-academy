                  ${isUnlocked ? `
                    <button onclick="openReader('${t.title}', '${paper.paper}', true)" class="flex-1 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-lg shadow transition text-center">
