      const date = document.getElementById("cashHandoverDateInput").value;
      const note = document.getElementById("cashNoteInput").value.trim();

      if (!name || !phone) {
        alert("দয়া করে শিক্ষার্থীর নাম ও মোবাইল নম্বর লিখুন!");
        return;
      }

      const newOrder = {
        id: `CSH-${Date.now().toString().slice(-6)}`,
        type: "cash",
        name, phone,
        receiver: "মো: রাহাত খান",
        handoverDate: date || "আজকেই",
        note,
        topic: `${selectedPaper} — ${selectedTopic}`,
        fileKey: `${selectedPaper} — ${selectedTopic}`.replace(" — ", "_"),
        amount: config.defaultPrice,
        status: "pending_cash",
        date: new Date().toLocaleDateString('bn-BD')
      };

      orders.unshift(newOrder);
      saveOrders();

      document.getElementById("checkoutBody").classList.add("hidden");
      document.getElementById("checkoutSuccessScreen").classList.remove("hidden");
      document.getElementById("successOrderHeadline").innerText = "ক্যাশ পেমেন্ট রিকোয়েস্ট সফল!";
      document.getElementById("successOrderMessage").innerText = `অর্ডার আইডি: ${newOrder.id}। মো: রাহাত খান নগদ টাকা বুঝে পাওয়ার পর অ্যাডমিন প্যানেল থেকে অনুমোদন দিলে পিডিএফ আনলক হবে।`;
    }

    // --- STUDENT DASHBOARD RENDERING ---
    function renderStudentDashboard() {
      // 1. Library List
      const libraryContainer = document.getElementById("studentLibraryList");
      if (entitlements.length === 0) {
        libraryContainer.innerHTML = `
          <div class="col-span-full py-8 text-center bg-slate-50 rounded-xl border border-slate-200">
            <p class="text-xs text-slate-500 font-semibold">আপনার লাইব্রেরিতে এখনো কোনো অনুমোদিত পিডিএফ নেই।</p>
          </div>
        `;
      } else {
        libraryContainer.innerHTML = entitlements.map(key => {
          const parts = key.split("_");
          const paper = parts[0];
          const topic = parts[1];
          return `
            <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between">
              <div>
                <span class="text-[10px] font-bold text-amber-700 bg-amber-100 px-2 py-0.5 rounded">${paper}</span>
                <h5 class="text-xs font-bold text-slate-900 mt-1">${topic}</h5>
              </div>
              <button onclick="openReader('${topic}', '${paper}', true)" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-lg shadow transition">
                পড়ুন
              </button>
            </div>
          `;
        }).join("");
      }

      // 2. Orders History
      const ordersContainer = document.getElementById("studentOrdersList");
      if (orders.length === 0) {
        ordersContainer.innerHTML = `
          <div class="py-6 text-center bg-slate-50 rounded-xl border border-slate-200">
            <p class="text-xs text-slate-500 font-semibold">কোনো পূর্ববর্তী অর্ডার পাওয়া যায়নি।</p>
          </div>
        `;
      } else {
        ordersContainer.innerHTML = orders.map(o => `
          <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <div class="flex items-center space-x-2">
                <span class="font-bold text-slate-900">${o.id}</span>
                <span class="text-[10px] text-slate-400">• ${o.date}</span>
                <span class="font-bold text-blue-700">৳${o.amount}</span>
              </div>
              <p class="text-slate-600 font-medium mt-0.5">${o.topic}</p>
              <p class="text-[11px] text-slate-500">${o.type === 'online' ? `অনলাইন (${o.method}) — TrxID: ${o.trx}` : `সরাসরি ক্যাশ (প্রাপক: ${o.receiver})`}</p>
            </div>
            <div>
              ${o.status === 'approved' ? `<span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 font-bold rounded-lg text-[11px]">✓ অনুমোদিত</span>` : 
                o.status === 'rejected' ? `<span class="px-2.5 py-1 bg-rose-100 text-rose-800 font-bold rounded-lg text-[11px]">✕ বাতিল</span>` : 
                `<span class="px-2.5 py-1 bg-amber-100 text-amber-800 font-bold rounded-lg text-[11px]">⏳ অনুমোদনের অপেক্ষায়</span>`}
            </div>
          </div>
        `).join("");
      }
    }

    // --- ADMIN PANEL LOGIC ---
    function openAdminModal() {
      openModal("adminModal");
    }

    function checkAdminLogin() {
      const pin = document.getElementById("adminPinInput").value;
      if (pin === "rahat2027" || pin === config.paymentNumber || pin === "admin") {
        document.getElementById("adminLoginBox").classList.add("hidden");
        document.getElementById("adminDashboardBox").classList.remove("hidden");
        populateAdminSelectors();
        renderAdminDashboard();
      } else {
        alert("ভুল পিন! ডিফল্ট পিন: rahat2027");
      }
    }

    function adminLogout() {
      document.getElementById("adminLoginBox").classList.remove("hidden");
      document.getElementById("adminDashboardBox").classList.add("hidden");
      document.getElementById("adminPinInput").value = "";
    }

    function setAdminTab(tabId) {
      const tabs = ['tabOnlinePay', 'tabCashPay', 'tabOfflineSale', 'tabPdfUpload', 'tabSettings'];
      tabs.forEach(t => {
        document.getElementById(t).classList.add("hidden");
      });
      document.getElementById(tabId).classList.remove("hidden");

      // Active button styling
      const buttons = [
        { id: 'btnTabOnlinePay', tab: 'tabOnlinePay' },
        { id: 'btnTabCashPay', tab: 'tabCashPay' },
        { id: 'btnTabOfflineSale', tab: 'tabOfflineSale' },
        { id: 'btnTabPdfUpload', tab: 'tabPdfUpload' },
        { id: 'btnTabSettings', tab: 'tabSettings' }
      ];
      buttons.forEach(b => {
        const el = document.getElementById(b.id);
        if (b.tab === tabId) {
          el.className = "px-3 py-1.5 rounded-lg bg-blue-600 text-white shrink-0";
        } else {
          el.className = "px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 shrink-0";
        }
      });
    }

    function populateAdminSelectors() {
      const uploadSelect = document.getElementById("adminUploadTopicSelect");
      const manualSelect = document.getElementById("manualSaleTopicSelect");
      let optionsHtml = "";

      CATALOG_DATA.forEach(p => {
        p.topics.forEach(t => {
          const key = `${p.paper}_${t.title}`;
          const isUp = !!uploadedPdfs[key];
          optionsHtml += `<option value="${key}">${isUp ? '✓ [PDF প্রস্তুত] ' : ''}${p.paper} — ${t.title}</option>`;
        });
      });

      uploadSelect.innerHTML = optionsHtml;
      manualSelect.innerHTML = optionsHtml;
    }

    function renderAdminDashboard() {
      // Calculate Metrics
      const pendingOnline = orders.filter(o => o.type === 'online' && o.status === 'pending_verification');
      const pendingCash = orders.filter(o => o.type === 'cash' && o.status === 'pending_cash');
      const approvedCount = orders.filter(o => o.status === 'approved').length;
      const uploadedCount = Object.keys(uploadedPdfs).length;

      document.getElementById("metricPendingOnline").innerText = `${pendingOnline.length} টি`;
      document.getElementById("metricPendingCash").innerText = `${pendingCash.length} টি`;
      document.getElementById("metricApprovedSales").innerText = `${approvedCount} টি`;
      document.getElementById("metricUploadedPdfCount").innerText = `${uploadedCount} / 151`;

      // Render Online Orders
      const onlineContainer = document.getElementById("adminOnlineOrdersList");
      if (pendingOnline.length === 0) {
        onlineContainer.innerHTML = `<div class="p-6 text-center text-slate-400 text-xs bg-slate-50 rounded-xl">🎉 কোনো পেন্ডিং অনলাইন পেমেন্ট নেই!</div>`;
      } else {
        onlineContainer.innerHTML = pendingOnline.map(o => `
          <div class="p-3.5 bg-slate-50 border border-slate-200 rounded-xl text-xs space-y-2">
            <div class="flex justify-between font-bold text-slate-900">
              <span>${o.name} (${o.phone})</span>
              <span class="text-emerald-700 font-extrabold">৳${o.amount}</span>
            </div>
            <p class="text-[11px] text-slate-600 font-medium">${o.topic}</p>
            <div class="flex items-center justify-between text-[11px] pt-1">
              <span class="font-mono bg-white px-2 py-0.5 rounded border border-slate-300 font-bold">${o.method}: ${o.trx}</span>
              <div class="flex space-x-1.5">
                <button onclick="rejectOrder('${o.id}')" class="px-2.5 py-1.5 bg-rose-50 text-rose-600 hover:bg-rose-100 font-bold rounded-lg transition">বাতিল</button>
                <button onclick="approveOrder('${o.id}')" class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg shadow transition">অনুমোদন করুন</button>
              </div>
            </div>
          </div>
        `).join("");
      }

      // Render Cash Orders
      const cashContainer = document.getElementById("adminCashOrdersList");
      if (pendingCash.length === 0) {
        cashContainer.innerHTML = `<div class="p-6 text-center text-slate-400 text-xs bg-slate-50 rounded-xl">🎉 কোনো পেন্ডিং ক্যাশ রিকোয়েস্ট নেই!</div>`;
      } else {
        cashContainer.innerHTML = pendingCash.map(o => `
          <div class="p-3.5 bg-amber-50/50 border border-amber-200 rounded-xl text-xs space-y-2">
            <div class="flex justify-between font-bold text-slate-900">
              <span>${o.name} (${o.phone})</span>
              <span class="text-amber-900 font-extrabold">৳${o.amount}</span>
            </div>
            <p class="text-[11px] text-slate-700 font-medium">${o.topic}</p>
            <p class="text-[10px] text-slate-500">প্রাপক: ${o.receiver} • তারিখ: ${o.handoverDate} ${o.note ? `• নোট: ${o.note}` : ''}</p>
            <div class="flex items-center justify-end space-x-1.5 pt-1">
              <button onclick="rejectOrder('${o.id}')" class="px-2.5 py-1.5 bg-rose-50 text-rose-600 hover:bg-rose-100 font-bold rounded-lg transition">বাতিল</button>
              <button onclick="approveOrder('${o.id}')" class="px-3.5 py-1.5 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-lg shadow transition">ক্যাশ গ্রহণ নিশ্চিত ও অনুমোদন</button>
            </div>
          </div>
        `).join("");
      }
    }

    function approveOrder(orderId) {
      const order = orders.find(o => o.id === orderId);
      if (!order) return;

      order.status = "approved";
      if (!entitlements.includes(order.fileKey)) {
        entitlements.push(order.fileKey);
      }

      saveOrders();
      saveEntitlements();
      renderAdminDashboard();
      filterCatalog();
      renderStudentDashboard();
      alert(`অর্ডার (${order.id}) সফলভাবে অনুমোদিত হয়েছে এবং ছাত্রের লাইব্রেরিতে পিডিএফ পড়ার অ্যাক্সেস দেওয়া হয়েছে!`);
    }

    function rejectOrder(orderId) {
      const order = orders.find(o => o.id === orderId);
      if (!order) return;

      order.status = "rejected";
      saveOrders();
      renderAdminDashboard();
      renderStudentDashboard();
      alert(`অর্ডার (${order.id}) বাতিল করা হয়েছে।`);
    }

    // --- MANUAL OFFLINE SALE ---
    function handleManualOfflineSale() {
      const name = document.getElementById("manualSaleStudentName").value.trim();
      const phone = document.getElementById("manualSaleStudentPhone").value.trim();
      const fileKey = document.getElementById("manualSaleTopicSelect").value;
      const amount = document.getElementById("manualSaleAmount").value;
      const receiver = document.getElementById("manualSaleReceiver").value;

      if (!name || !phone) {
        alert("দয়া করে শিক্ষার্থীর নাম ও মোবাইল নম্বর লিখুন!");
        return;
      }

      const parts = fileKey.split("_");
      const topicName = `${parts[0]} — ${parts[1]}`;

      const manualOrder = {
        id: `DIR-${Date.now().toString().slice(-6)}`,
        type: "cash",
        name, phone, receiver,
        topic: topicName,
        fileKey: fileKey,
        amount: parseInt(amount) || config.defaultPrice,
        status: "approved", // Directly approved because Admin collected cash
        date: new Date().toLocaleDateString('bn-BD')
      };

      orders.unshift(manualOrder);
      if (!entitlements.includes(fileKey)) {
        entitlements.push(fileKey);
      }

      saveOrders();
      saveEntitlements();

      document.getElementById("manualSaleStudentName").value = "";
      document.getElementById("manualSaleStudentPhone").value = "";

      renderAdminDashboard();
      filterCatalog();
      renderStudentDashboard();
      alert(`অফলাইন ক্যাশ সেল সফল! ৳${amount} ক্যাশ রেকর্ড করা হয়েছে এবং "${topicName}" এর অ্যাক্সেস শিক্ষার্থীর জন্য উন্মুক্ত হয়েছে।`);
    }

    // --- MOBILE PDF UPLOADER ---
    function handleAdminPdfUpload() {
      const fileKey = document.getElementById("adminUploadTopicSelect").value;
      const input = document.getElementById("adminPdfFileInput");

      if (!input.files || input.files.length === 0) {
        alert("দয়া করে আপনার ফোন থেকে একটি PDF ফাইল সিলেক্ট করুন!");
        return;
      }

      const file = input.files[0];
      if (file.type !== "application/pdf") {
        alert("শুধুমাত্র PDF ফরম্যাটের ফাইল আপলোড করা যাবে!");
        return;
      }

      const blobUrl = URL.createObjectURL(file);
      const sizeFormatted = (file.size / (1024 * 1024)).toFixed(2) + " MB";

      uploadedPdfs[fileKey] = {
        name: file.name,
        size: sizeFormatted,
        url: blobUrl,
        date: new Date().toLocaleDateString('bn-BD')
      };

      try {
        localStorage.setItem("rahat_uploaded_pdfs", JSON.stringify(uploadedPdfs));
      } catch(e) {}

      alert(`সফল হয়েছে! "${file.name}" ফাইলটি এই অধ্যায়ে সংরক্ষিত হয়েছে।`);
      input.value = "";
      populateAdminSelectors();
      renderAdminDashboard();
      filterCatalog();
    }

    // --- SAVE EDITABLE SETTINGS ---
    function savePlatformSettings() {
      config.paymentNumber = document.getElementById("configPaymentNumber").value.trim();
      config.defaultPrice = parseInt(document.getElementById("configDefaultPrice").value) || 30;
      config.whatsappLink = document.getElementById("configWhatsappLink").value.trim();
      config.callNumber = document.getElementById("configCallNumber").value.trim();
      config.heroHeading = document.getElementById("configHeroHeading").value.trim();
      config.heroSubheading = document.getElementById("configHeroSubheading").value.trim();

      localStorage.setItem("rahat_academy_config", JSON.stringify(config));
      applyConfigToDOM();
      filterCatalog();
      alert("প্ল্যাটফর্মের সমস্ত সেটিংস কোড এডিট ছাড়াই সফলভাবে সংরক্ষিত হয়েছে!");
    }

    function saveOrders() {
      localStorage.setItem("rahat_orders", JSON.stringify(orders));
    }

    function saveEntitlements() {
      localStorage.setItem("rahat_entitlements", JSON.stringify(entitlements));
    }

    // Run on startup
    window.addEventListener("DOMContentLoaded", initApp);
  </script>
</body>
